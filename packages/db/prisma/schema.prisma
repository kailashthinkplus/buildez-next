// =======================================
// PRISMA CONFIG (ROOT-LEVEL)
// =======================================

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =======================================
// ENUMS
// =======================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TENANT_ADMIN
  USER
}

enum AuthProvider {
  PASSWORD
  GOOGLE
  OTP
}

enum AIConversationPhase {
  INTERVIEW // Asking questions, collecting inputs
  READY // Questions done, waiting for user confirmation
  GENERATING // Blueprint generation allowed
  DONE // Generation finished
}

// ---------------------------------------
// ONBOARDING ENUMS
// ---------------------------------------

enum AccountType {
  personal
  business
  agency
}

enum CompanySize {
  solo
  small_2_10
  medium_11_50
  large_50_plus
}

enum PrimaryUseCase {
  company_website
  landing_pages
  marketing
  internal_tools
  other
}

// ---------------------------------------
// SITE / PAGE ENUMS
// ---------------------------------------

enum SiteStatus {
  DRAFT
  PUBLISHED
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

// ✅ NEW: Render Mode
enum RenderMode {
  BLUEPRINT // Traditional block editor
  REACT // Live React preview (Lovable style)
}

enum MediaSource {
  UPLOAD
  AI
  STOCK
  ICON
}

enum MediaType {
  IMAGE
  VIDEO
  SVG
  ICON
  PDF
  AUDIO
}

enum ShopProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ShopOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  FULFILLED
  CANCELLED
  REFUNDED
}

enum ShopPaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ShopFulfillmentStatus {
  UNFULFILLED
  PARTIAL
  FULFILLED
  RETURNED
}

enum ShopDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum ShopPaymentProvider {
  RAZORPAY
  PAYPAL
  STRIPE
  DODO
  COD
}

// =======================================
// CORE USER
// =======================================

model User {
  id String @id @default(cuid())

  email     String? @unique
  phone     String? @unique
  name      String?
  avatarUrl String?
  bio       String?
  jobTitle  String?
  company   String?
  website   String?
  city      String?
  country   String?
  timezone  String?

  passwordHash String?
  googleId     String?  @unique
  role         UserRole @default(USER)

  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)
  isActive        Boolean @default(true)

  recoveryCodes String[] @default([])

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  totpSecret     String?
  totpEnabled    Boolean   @default(false)
  totpVerifiedAt DateTime?

  // RELATIONS
  sessions             Session[]
  authLogs             AuthLog[]
  onboarding           UserOnboarding?
  teamMemberships      TeamMember[]
  refreshTokens        RefreshToken[]
  loginAttempts        LoginAttempt[]
  verificationTokens   VerificationToken[]
  workspaceMemberships WorkspaceMember[]
  AiEvent              AiEvent[]
  mediaAssets          MediaAsset[] // ✅ NEW

  ownedTenants Tenant[]       @relation("TenantOwner")
  tenantUsers  Tenant[]       @relation("TenantUsers")
  Subscription Subscription[]

  @@index([email])
  @@index([phone])
  @@index([role])
}

// =======================================
// USER ONBOARDING MODEL
// =======================================

model UserOnboarding {
  id     String @id @default(cuid())
  userId String @unique

  accountType    AccountType?
  companySize    CompanySize?
  primaryUseCase PrimaryUseCase?

  firstName  String?
  lastName   String?
  city       String?
  country    String?
  profession String?
  website    String?

  businessName String?

  planCode     String?
  billingCycle String?
  domain       String?
  domainSkipped Boolean @default(false)

  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("UserOnboarding")
}

// =======================================
// SESSION / OTP / AUTH LOGS
// =======================================

model Session {
  id String @id @default(cuid())

  userId   String
  provider AuthProvider

  ipAddress String?
  userAgent String?

  expiresAt DateTime
  revoked   Boolean  @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revoked])
}

model Otp {
  id String @id @default(cuid())

  email String?
  phone String?

  // Scopes an OTP to what it's allowed to authorize, so a code issued
  // for one flow (e.g. super-admin login) can never be replayed to
  // authorize a different one (e.g. a tenant password reset).
  purpose String @default("SUPER_ADMIN_LOGIN")

  codeHash  String
  expiresAt DateTime

  attempts Int     @default(0)
  consumed Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([email])
  @@index([phone])
  @@index([expiresAt])
}

model AuthLog {
  id String @id @default(cuid())

  userId   String?
  provider AuthProvider
  success  Boolean

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([provider])
  @@index([createdAt])
}

// =======================================
// AUTH TOKENS / SECURITY
// =======================================

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  token     String   @unique
  type      String
  expiresAt DateTime

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([userId])
}

model RefreshToken {
  id        String  @id @default(cuid())
  userId    String
  token     String  @unique
  userAgent String?
  ipAddress String?

  revoked   Boolean  @default(false)
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([revoked])
}

model LoginAttempt {
  id     String  @id @default(cuid())
  email  String?
  phone  String?
  userId String?

  ipAddress String?
  userAgent String?
  method    String
  success   Boolean

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([phone])
  @@index([userId])
  @@index([method])
}

// =======================================
// TENANT
// =======================================

model Tenant {
  id       String  @id @default(cuid())
  name     String
  domain   String?
  isActive Boolean @default(true)

  ownerId String?
  owner   User?   @relation("TenantOwner", fields: [ownerId], references: [id])

  users User[] @relation("TenantUsers")

  subscriptionId String?       @unique
  subscription   Subscription? @relation("TenantActiveSubscription")

  subscriptions Subscription[] @relation("TenantSubscriptionHistory")

  teams                Team[]
  themes               Theme[]
  sites                Site[]
  events               TenantEvent[]
  complianceAudits     ComplianceAudit[]
  siteSnapshots        SiteSnapshot[]
  siteRenders          SiteRender[]
  siteDomains          SiteDomain[]
  siteSubscriptions    SiteSubscription[]
  blueprints           Blueprint[]
  planUsages           PlanUsage[]
  AiEvent              AiEvent[]
  aiCreditReservations AiCreditReservation[]
  aiCreditLedger       AiCreditLedgerEntry[]
  aiSnapshots          AIBlueprintSnapshot[]
  v12Projects          V12Project[]

  aiSuspended Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TenantEvent {
  id        String   @id @default(cuid())
  tenantId  String
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// =======================================
// TEAMS
// =======================================

enum TeamRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model Team {
  id       String @id @default(cuid())
  tenantId String
  name     String
  slug     String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant       @relation(fields: [tenantId], references: [id])
  members TeamMember[]
  invites TeamInvite[]

  @@index([tenantId])
}

model TeamMember {
  id     String   @id @default(cuid())
  teamId String
  userId String
  role   TeamRole @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model TeamInvite {
  id     String       @id @default(cuid())
  teamId String
  email  String
  role   TeamRole
  status InviteStatus @default(PENDING)

  invitedBy String?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id])

  @@index([email])
  @@index([teamId])
}

// =======================================
// THEMES
// =======================================

enum ThemeVisibility {
  PUBLIC
  PRIVATE
  SYSTEM
}

enum ThemeVersionStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
}

model Theme {
  id         String          @id @default(cuid())
  tenantId   String?
  name       String
  slug       String          @unique
  visibility ThemeVisibility @default(PRIVATE)

  description String?
  thumbnail   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant?        @relation(fields: [tenantId], references: [id])
  versions ThemeVersion[]
  assets   ThemeAsset[]

  @@index([tenantId])
}

model ThemeVersion {
  id      String             @id @default(cuid())
  themeId String
  version Int
  status  ThemeVersionStatus @default(DRAFT)

  blueprint Json?
  tokens    Json?
  settings  Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  theme  Theme        @relation(fields: [themeId], references: [id])
  assets ThemeAsset[]

  @@unique([themeId, version])
  @@index([themeId])
}

model ThemeAsset {
  id        String  @id @default(cuid())
  themeId   String
  versionId String?

  type String
  name String
  url  String?
  meta Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  theme   Theme         @relation(fields: [themeId], references: [id])
  version ThemeVersion? @relation(fields: [versionId], references: [id])

  @@index([themeId])
  @@index([versionId])
}

model MediaAsset {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // File info
  url      String
  filename String
  fileHash String @unique
  fileSize Int

  mediaType MediaType
  mimeType  String

  width  Int?
  height Int?

  alt   String?
  title String?
  tags  String[]

  // Ownership
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  usageCount Int       @default(0)
  lastUsedAt DateTime?

  // ⭐ NEW

  source MediaSource @default(UPLOAD)

  provider String?

  prompt String?

  negativePrompt String?

  model String?

  seed Int?

  aspectRatio String?

  thumbnailUrl String?

  blurhash String?

  dominantColor String?

  isFavorite Boolean @default(false)

  folder String?

  metadata Json?

  @@index([siteId])
  @@index([uploadedById])
  @@index([mimeType])
  @@index([source])
  @@index([createdAt])
}

// =======================================
// SITE / PAGE
// =======================================

model Site {
  id       String     @id @default(cuid())
  tenantId String
  logoUrl  String? // ✅ Brand logo
  name     String
  slug     String
  status   SiteStatus @default(DRAFT)

  designTokens Json? // ✅ Stores brand colors extracted from logo
  settings     Json? // Site-wide general, SEO, analytics, privacy and social settings

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  archivedAt DateTime?

  tenant           Tenant                @relation(fields: [tenantId], references: [id])
  subscriptions    SiteSubscription[]
  pages            Page[]
  complianceAudits ComplianceAudit[]
  snapshots        SiteSnapshot[]
  renders          SiteRender[]
  domains          SiteDomain[]
  blueprints       Blueprint[]
  legacyDomains    Domain[]
  mediaAssets      MediaAsset[] // ✅ NEW: Media library per site
  layout           SiteLayout?
  aiSnapshots      AIBlueprintSnapshot[]
  cmsCollections   CmsCollection[]
  crmLeads         CrmLead[]
  crmApiKeys       CrmApiKey[]
  agentRuns        AgentRun[]
  integrations     SiteIntegration[]
  shop             Shop?
  v12Project       V12Project?
  feedback         WebsiteFeedback[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

// =======================================
// APPS MARKETPLACE / SITE INTEGRATIONS
// =======================================

model SiteIntegration {
  id      String @id @default(cuid())
  siteId  String
  appSlug String

  config Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, appSlug])
  @@index([siteId])
}

// =======================================
// V12 REACT PROJECT WORKSPACE
// =======================================

model V12Project {
  id                String   @id @default(cuid())
  siteId            String   @unique
  tenantId          String
  currentRevision   Int      @default(0)
  publishedRevision Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  site        Site                   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  files       V12ProjectFile[]
  revisions   V12ProjectRevision[]
  checkpoints V12ProjectCheckpoint[]

  @@index([tenantId])
}

model V12ProjectFile {
  id          String   @id @default(cuid())
  projectId   String
  path        String
  content     String
  contentHash String
  revision    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project V12Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId, revision])
}

model V12ProjectRevision {
  id         String   @id @default(cuid())
  projectId  String
  sequence   Int
  operations Json
  createdBy  String?
  createdAt  DateTime @default(now())

  project     V12Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checkpoints V12ProjectCheckpoint[]

  @@unique([projectId, sequence])
  @@index([projectId, createdAt])
}

model V12ProjectCheckpoint {
  id         String   @id @default(cuid())
  projectId  String
  revisionId String
  label      String?
  snapshot   Json
  createdBy  String?
  createdAt  DateTime @default(now())

  project  V12Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revision V12ProjectRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([revisionId])
}

// Tracks a V12 generation across multiple staged HTTP requests so no
// single request has to run the whole pipeline (research + design +
// media + codegen) within one function invocation's timeout.
model V12GenerationJob {
  id        String   @id @default(cuid())
  siteId    String
  tenantId  String
  stage     String // "plan" | "generate"
  status    String // "running" | "stage_complete" | "done" | "failed" | "needs_input"
  state     Json? // serialized V12PipelineState once the plan stage completes
  input     Json // original request: prompt, context, creativeDirection, selectedElement, mode, pageId
  result    Json? // terminal result once status is "done" | "failed" | "needs_input"
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, tenantId])
  @@index([tenantId, createdAt])
}

// =======================================
// SHOPEZ — TENANT ECOMMERCE
// =======================================

model Shop {
  id               String   @id @default(cuid())
  siteId           String   @unique
  tenantId         String
  name             String
  currency         String   @default("INR")
  country          String   @default("IN")
  supportEmail     String?
  orderPrefix      String   @default("SZ")
  taxInclusive     Boolean  @default(false)
  taxRate          Decimal  @default(0) @db.Decimal(5, 2)
  freeShippingOver Decimal? @db.Decimal(12, 2)
  flatShippingRate Decimal  @default(0) @db.Decimal(12, 2)
  isPublished      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  site        Site                     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  products    ShopProduct[]
  collections ShopCollection[]
  customers   ShopCustomer[]
  orders      ShopOrder[]
  discounts   ShopDiscount[]
  payments    ShopPaymentIntegration[]

  @@index([tenantId])
}

model ShopProduct {
  id              String            @id @default(cuid())
  shopId          String
  title           String
  handle          String
  description     String            @default("")
  vendor          String?
  productType     String?
  status          ShopProductStatus @default(DRAFT)
  tags            String[]          @default([])
  seoTitle        String?
  seoDescription  String?
  storySections   Json?
  trackQuantity   Boolean           @default(true)
  continueSelling Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  shop        Shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  images      ShopProductImage[]
  options     ShopProductOption[]
  variants    ShopProductVariant[]
  collections ShopCollectionProduct[]
  orderItems  ShopOrderItem[]

  @@unique([shopId, handle])
  @@index([shopId, status])
}

model ShopProductImage {
  id        String      @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int         @default(0)
  product   ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ShopProductOption {
  id        String      @id @default(cuid())
  productId String
  name      String
  values    String[]    @default([])
  position  Int         @default(0)
  product   ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ShopProductVariant {
  id             String          @id @default(cuid())
  productId      String
  title          String          @default("Default")
  sku            String?
  barcode        String?
  price          Decimal         @db.Decimal(12, 2)
  compareAtPrice Decimal?        @db.Decimal(12, 2)
  cost           Decimal?        @db.Decimal(12, 2)
  inventory      Int             @default(0)
  weightGrams    Int?
  optionValues   Json?
  position       Int             @default(0)
  product        ShopProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems     ShopOrderItem[]

  @@index([productId])
  @@index([sku])
}

model ShopCollection {
  id          String                  @id @default(cuid())
  shopId      String
  title       String
  handle      String
  description String                  @default("")
  imageUrl    String?
  shop        Shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products    ShopCollectionProduct[]

  @@unique([shopId, handle])
}

model ShopCollectionProduct {
  collectionId String
  productId    String
  position     Int            @default(0)
  collection   ShopCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      ShopProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

model ShopCustomer {
  id               String                @id @default(cuid())
  shopId           String
  email            String
  firstName        String?
  lastName         String?
  phone            String?
  acceptsMarketing Boolean               @default(false)
  addresses        Json?
  notes            String?
  passwordHash     String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  shop             Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders           ShopOrder[]
  sessions         ShopCustomerSession[]

  @@unique([shopId, email])
}

model ShopCustomerSession {
  id         String       @id @default(cuid())
  customerId String
  tokenHash  String       @unique
  expiresAt  DateTime
  createdAt  DateTime     @default(now())
  customer   ShopCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

model ShopDiscount {
  id            String           @id @default(cuid())
  shopId        String
  code          String
  type          ShopDiscountType
  value         Decimal          @db.Decimal(12, 2)
  minimumAmount Decimal?         @db.Decimal(12, 2)
  usageLimit    Int?
  usageCount    Int              @default(0)
  startsAt      DateTime         @default(now())
  endsAt        DateTime?
  active        Boolean          @default(true)
  shop          Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders        ShopOrder[]

  @@unique([shopId, code])
}

model ShopOrder {
  id                String                @id @default(cuid())
  shopId            String
  customerId        String?
  discountId        String?
  orderNumber       Int
  email             String
  phone             String?
  currency          String
  subtotal          Decimal               @db.Decimal(12, 2)
  discount          Decimal               @default(0) @db.Decimal(12, 2)
  shipping          Decimal               @default(0) @db.Decimal(12, 2)
  tax               Decimal               @default(0) @db.Decimal(12, 2)
  total             Decimal               @db.Decimal(12, 2)
  status            ShopOrderStatus       @default(PENDING)
  paymentStatus     ShopPaymentStatus     @default(PENDING)
  fulfillmentStatus ShopFulfillmentStatus @default(UNFULFILLED)
  shippingAddress   Json
  billingAddress    Json?
  note              String?
  provider          ShopPaymentProvider?
  providerOrderId   String?
  providerPaymentId String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  shop              Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer          ShopCustomer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discountCode      ShopDiscount?         @relation(fields: [discountId], references: [id], onDelete: SetNull)
  items             ShopOrderItem[]

  @@unique([shopId, orderNumber])
  @@index([shopId, createdAt])
  @@index([providerOrderId])
}

model ShopOrderItem {
  id           String              @id @default(cuid())
  orderId      String
  productId    String?
  variantId    String?
  title        String
  variantTitle String?
  sku          String?
  quantity     Int
  unitPrice    Decimal             @db.Decimal(12, 2)
  total        Decimal             @db.Decimal(12, 2)
  order        ShopOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      ShopProduct?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant      ShopProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model ShopPaymentIntegration {
  id              String              @id @default(cuid())
  shopId          String
  provider        ShopPaymentProvider
  enabled         Boolean             @default(false)
  publicKey       String?
  encryptedSecret String?
  webhookSecret   String?
  mode            String              @default("test")
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  shop            Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, provider])
}

model SupportRequest {
  id        String    @id @default(cuid())
  type      String    @default("SUPPORT")
  name      String?
  email     String
  subject   String?
  message   String
  pageUrl   String?
  severity  String?
  status    String    @default("NEW")
  source    String    @default("marketing-site")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([type, createdAt])
  @@index([status])
}

model BlogPost {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  excerpt       String?
  content       String    @db.Text
  coverImageUrl String?
  authorName    String?
  status        String    @default("DRAFT")
  tags          String[]  @default([])
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, publishedAt])
}

model ChangelogEntry {
  id        String    @id @default(cuid())
  title     String
  summary   String    @db.Text
  bullets   String[]  @default([])
  status    String    @default("DRAFT")
  publishedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, publishedAt])
}

model CrmLead {
  id              String    @id @default(cuid())
  siteId          String
  name            String
  email           String?
  phone           String?
  company         String?
  message         String?
  source          String    @default("manual")
  sourceUrl       String?
  status          String    @default("NEW")
  score           Int       @default(0)
  temperature     String    @default("WARM")
  assignedToId    String?
  assignedToName  String?
  tags            String[]  @default([])
  customData      Json?
  notes           String?
  consent         Boolean   @default(false)
  lastContactedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  site           Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  communications CrmCommunication[]

  @@index([siteId, createdAt])
  @@index([siteId, status])
  @@index([siteId, email])
}

model CrmCommunication {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  direction String   @default("OUTBOUND")
  subject   String?
  content   String
  createdBy String?
  createdAt DateTime @default(now())

  lead CrmLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

// =======================================
// AI AGENTS
// =======================================

model AgentRun {
  id          String   @id @default(cuid())
  siteId      String
  tenantId    String
  agentId     String
  pageId      String?
  prompt      String?
  summary     String
  findings    Json
  generatedBy String   @default("analytics")
  createdAt   DateTime @default(now())

  site     Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  messages AgentMessage[]

  @@index([siteId, agentId, createdAt])
  @@index([siteId, createdAt])
}

model AgentMessage {
  id        String   @id @default(cuid())
  runId     String
  role      String
  content   String
  createdAt DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
}

model WebsiteFeedback {
  id        String   @id @default(cuid())
  siteId    String
  tenantId  String
  userId    String?
  pageId    String?
  rating    Int
  comment   String?
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
  @@index([status])
}

model CrmApiKey {
  id         String    @id @default(cuid())
  siteId     String
  name       String
  keyPrefix  String
  keyHash    String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model CmsCollection {
  id          String   @id @default(cuid())
  siteId      String
  name        String
  slug        String
  description String?
  icon        String?  @default("database")
  fields      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site    Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  entries CmsEntry[]

  @@unique([siteId, slug])
  @@index([siteId])
}

model CmsEntry {
  id           String   @id @default(cuid())
  collectionId String
  data         Json
  status       String   @default("DRAFT")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection CmsCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([status])
}

model SiteLayout {
  id     String @id @default(cuid())
  siteId String @unique

  header Json?
  footer Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id])
}

model Domain {
  id       String @id @default(cuid())
  hostname String @unique
  siteId   String
  site     Site   @relation(fields: [siteId], references: [id])
}

model Page {
  id     String     @id @default(cuid())
  siteId String
  title  String
  slug   String
  status PageStatus @default(DRAFT)

  // ✅ NEW: React code storage (Lovable style)
  reactCode  String?    @db.Text // Generated React TSX code
  renderMode RenderMode @default(BLUEPRINT) // Blueprint or React

  publishedAt        DateTime?
  scheduledPublishAt DateTime?
  customCss          String?    @db.Text
  customJs           String?    @db.Text

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deleted       Boolean   @default(false)
  deletedAt     DateTime?
  deletedByUser String?

  // ✅ NEW: Metadata for AI generation tracking
  metadata Json? // { generatedAt, usedBrandColors, usedLogo, aiModel, tokensUsed, etc. }

  site          Site                  @relation(fields: [siteId], references: [id])
  blueprint     Blueprint?
  previewTokens PreviewToken[]
  aiSnapshots   AIBlueprintSnapshot[]

  @@unique([siteId, slug])
  @@index([siteId])
  @@index([status])
  @@index([renderMode]) // ✅ NEW: Query by render mode
  @@index([scheduledPublishAt])
}

model PreviewToken {
  token     String   @id
  pageId    String
  expiresAt DateTime

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model AIBlueprintSnapshot {
  id String @id @default(cuid())

  pageId   String
  siteId   String
  tenantId String

  blueprint Json

  createdAt DateTime @default(now())

  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  site   Site   @relation(fields: [siteId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([pageId])
  @@index([siteId])
  @@index([tenantId])
}

// =======================================
// BLUEPRINT SYSTEM
// =======================================

model Blueprint {
  id       String @id @default(cuid())
  pageId   String @unique
  siteId   String
  tenantId String

  data          Json
  schemaVersion Int  @default(1)

  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page   Page   @relation(fields: [pageId], references: [id])
  site   Site   @relation(fields: [siteId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  history BlueprintHistory[]

  @@index([tenantId])
  @@index([siteId])
}

model BlueprintHistory {
  id          String @id @default(cuid())
  blueprintId String
  pageId      String
  siteId      String
  tenantId    String

  data          Json
  schemaVersion Int  @default(1)

  createdAt DateTime @default(now())
  createdBy String?

  blueprint Blueprint @relation(fields: [blueprintId], references: [id])

  @@index([blueprintId])
  @@index([pageId])
  @@index([tenantId])
  @@index([siteId])
}

// =======================================
// PLAN SYSTEM
// =======================================

model Plan {
  id   String @id @default(cuid())
  code String @unique
  name String

  maxSites    Int
  maxPages    Int
  aiCredits   Int
  teamMembers Int

  aiAgentRunLimitPerHour       Int @default(20)
  aiAgentFollowupLimitPerHour  Int @default(40)
  builderAgentLimitPerHour     Int @default(30)

  uploadRateLimitPerHour Int @default(30)
  maxDailyUploads        Int @default(50)

  isPublic Boolean @default(true)

  createdAt DateTime @default(now())

  pricing           PlanPricing[]
  subscriptions     Subscription[]
  siteSubscriptions SiteSubscription[]
  features          PlanFeature[]
}

model PlanPricing {
  id           String  @id @default(cuid())
  planCode     String
  billingCycle String
  currency     String
  amount       Int
  isActive     Boolean @default(true)

  razorpayPlanId String?
  stripePriceId  String?
  dodoProductId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan Plan @relation(fields: [planCode], references: [code])

  @@unique([planCode, billingCycle])
  @@index([planCode])
  @@index([dodoProductId])
}

model PlanFeature {
  id       String @id @default(cuid())
  planCode String
  key      String
  value    String
  type     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan Plan @relation(fields: [planCode], references: [code])

  @@unique([planCode, key])
  @@index([planCode])
}

model PlanUsage {
  id           String  @id @default(cuid())
  tenantId     String
  key          String
  used         Int
  billingCycle String?

  periodStart DateTime  @default(now())
  periodEnd   DateTime?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key, periodStart])
  @@index([tenantId])
}

// =======================================
// AI CREDIT RESERVATIONS / LEDGER
// =======================================

model AiCreditReservation {
  id            String @id @default(cuid())
  reservationId String @unique

  tenantId String
  userId   String?
  siteId   String?

  planCode String?

  amount Int

  planCreditsReserved  Int @default(0)
  topUpCreditsReserved Int @default(0)

  planUsageId  String?
  topUpUsageId String?

  // RESERVED | CAPTURED | RELEASED
  status String @default("RESERVED")

  releaseReason String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  capturedAt DateTime?
  releasedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ledgerEntries AiCreditLedgerEntry[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([createdAt])
}

model AiCreditLedgerEntry {
  id String @id @default(cuid())

  tenantId      String
  reservationId String?

  // RESERVE | CAPTURE | RELEASE | TOPUP_GRANT |
  // TOPUP_PURCHASE | ADMIN_ADJUSTMENT
  type String

  amount Int

  planCredits  Int @default(0)
  topUpCredits Int @default(0)

  planCode String?
  reason   String?

  // Used by payment callbacks/admin actions so the same external
  // operation cannot credit the account twice.
  idempotencyKey String @unique

  metadata Json?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  reservation AiCreditReservation? @relation(fields: [reservationId], references: [reservationId], onDelete: SetNull)

  @@index([tenantId])
  @@index([reservationId])
  @@index([tenantId, createdAt])
}

// =======================================
// SUBSCRIPTIONS
// =======================================

model Subscription {
  id String @id @default(cuid())

  tenantActiveId String? @unique
  tenantActive   Tenant? @relation("TenantActiveSubscription", fields: [tenantActiveId], references: [id])

  tenantHistoryId String?
  tenantHistory   Tenant? @relation("TenantSubscriptionHistory", fields: [tenantHistoryId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  planCode      String?
  billingCycle  String?
  status        String
  paymentStatus String?

  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?

  dodoCustomerId        String?
  dodoSubscriptionId    String?   @unique
  dodoCheckoutSessionId String?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean   @default(false)
  expiryAlertSentAt     DateTime?

  amountPaid Int?
  currency   String?
  startedAt  DateTime?
  paidAt     DateTime?

  couponCode     String?
  discountAmount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Plan      Plan?    @relation(fields: [planId], references: [id])
  planId    String?

  @@index([tenantHistoryId])
  @@index([userId])
  @@index([dodoCustomerId])
}

model Coupon {
  id          String  @id @default(cuid())
  code        String  @unique
  description String?

  /// "PERCENTAGE" | "FLAT"
  type     String
  /// Percentage: basis points (2000 = 20%). Flat: minor units of `currency`.
  amount   Int
  currency String?

  /// Empty = valid for every plan / cycle.
  planCodes     String[]
  billingCycles String[]

  /// Minor units; order must be at least this much before the coupon applies.
  minAmount Int?

  usageLimit   Int?
  timesUsed    Int  @default(0)
  perUserLimit Int? @default(1)
  firstTimeOnly Boolean @default(false)

  startsAt  DateTime?
  expiresAt DateTime?
  isActive  Boolean   @default(true)

  /// Mirrored discount object in Dodo Payments, created alongside this row so
  /// Dodo independently enforces the same limits at charge time.
  dodoDiscountId String?

  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions CouponRedemption[]

  @@index([isActive])
}

model CouponRedemption {
  id       String @id @default(cuid())
  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id])

  userId         String
  tenantId       String?
  subscriptionId String? @unique

  amountDiscounted Int
  currency         String

  createdAt DateTime @default(now())

  @@index([couponId])
  @@index([userId])
}

model BillingTransaction {
  id                String   @id @default(cuid())
  tenantId          String
  userId            String?
  subscriptionId    String?
  providerPaymentId String   @unique
  type              String   @default("SUBSCRIPTION")
  status            String
  amountMinor       Int
  currency          String
  planCode          String?
  billingCycle      String?
  paidAt            DateTime?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([subscriptionId])
  @@index([status])
}

model SiteSubscription {
  id       String @id @default(cuid())
  siteId   String
  tenantId String
  planCode String
  status   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site   Site   @relation(fields: [siteId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   Plan   @relation(fields: [planCode], references: [code])

  @@index([tenantId])
  @@index([siteId])
  @@index([planCode])
}

// =======================================
// COMPLIANCE SYSTEM
// =======================================

enum ComplianceLevel {
  PASS
  WARN
  BLOCK
}

model ComplianceAudit {
  id       String  @id @default(cuid())
  siteId   String
  tenantId String
  pageId   String?

  level   ComplianceLevel
  reasons String[]

  createdAt DateTime @default(now())

  site   Site   @relation(fields: [siteId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([siteId])
  @@index([tenantId])
  @@index([level])
}

// =======================================
// SYSTEM NOTIFICATIONS
// =======================================

model SystemNotification {
  id String @id @default(cuid())

  type    String
  title   String
  message String

  entityType String?
  entityId   String?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([type])
  @@index([isRead])
}

// =======================================
// SNAPSHOTS
// =======================================

enum SnapshotStatus {
  PUBLISHED
  UNPUBLISHED
  BLOCKED
}

model SiteSnapshot {
  id       String @id @default(cuid())
  siteId   String
  tenantId String

  status  SnapshotStatus
  version Int

  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  site    Site           @relation(fields: [siteId], references: [id])
  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  pages   PageSnapshot[]
  renders SiteRender[]

  @@unique([siteId, version])
  @@index([siteId])
  @@index([tenantId])
  @@index([status])
}

model PageSnapshot {
  id             String @id @default(cuid())
  siteSnapshotId String
  pageId         String

  title   String
  slug    String
  content Json

  createdAt DateTime @default(now())

  siteSnapshot SiteSnapshot @relation(fields: [siteSnapshotId], references: [id])

  @@index([siteSnapshotId])
  @@index([pageId])
}

// =======================================
// RUNTIME RENDER ENGINE
// =======================================

model SiteRender {
  id         String @id @default(cuid())
  siteId     String
  tenantId   String
  snapshotId String

  version Int
  status  String

  createdAt DateTime @default(now())

  site     Site         @relation(fields: [siteId], references: [id])
  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  snapshot SiteSnapshot @relation(fields: [snapshotId], references: [id])

  pages RenderedPage[]

  @@index([siteId])
  @@index([tenantId])
  @@index([snapshotId])
}

model RenderedPage {
  id       String @id @default(cuid())
  renderId String

  slug String
  html String  @db.Text // ✅ Changed to Text for large HTML
  css  String? @db.Text
  js   String? @db.Text

  contentHash String
  sizeBytes   Int

  createdAt DateTime @default(now())

  render SiteRender @relation(fields: [renderId], references: [id])

  @@unique([renderId, slug])
  @@index([renderId])
}

// =======================================
// DOMAINS + SSL
// =======================================

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
}

model SiteDomain {
  id       String @id @default(cuid())
  siteId   String
  tenantId String

  domain String       @unique
  status DomainStatus @default(PENDING)

  cnameTarget String
  verifiedAt  DateTime?
  verificationToken String? @unique
  dnsVerifiedAt     DateTime?
  lastCheckedAt     DateTime?
  lastDnsResult     Json?
  sslStatus         String @default("PENDING")
  sslActivatedAt    DateTime?
  provider          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site   Site   @relation(fields: [siteId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([siteId])
  @@index([tenantId])
  @@index([domain])
}

model SslCertificate {
  id       String @id @default(cuid())
  domain   String
  siteId   String
  tenantId String

  certPath String
  keyPath  String

  issuedAt  DateTime @default(now())
  expiresAt DateTime

  status String

  createdAt DateTime @default(now())

  @@index([domain])
  @@index([siteId])
  @@index([tenantId])
}

// =======================================
// TRAFFIC ANALYTICS
// =======================================

model TrafficEvent {
  id          String   @id @default(cuid())
  tenantId    String
  siteId      String
  domain      String
  path        String
  method      String
  status      Int
  country     String?
  city        String?
  referrer    String?
  device      String
  visitorHash String
  sessionId   String?
  eventType   String   @default("pageview")
  metadata    Json?
  bucket      DateTime
  createdAt   DateTime @default(now())

  @@index([siteId, bucket])
  @@index([siteId, eventType, createdAt])
  @@index([sessionId])
  @@index([tenantId, bucket])
  @@index([bucket])
}

model TrafficRollupHourly {
  id        String   @id @default(cuid())
  siteId    String
  hour      DateTime
  pageViews Int
  visitors  Int
  bots      Int

  @@unique([siteId, hour])
  @@index([hour])
}

// =======================================
// AI EVENTS / LOGS
// =======================================

model AiEvent {
  id String @id @default(cuid())

  tenantId String
  userId   String?
  siteId   String?
  pageId   String?

  action   String
  prompt   String? @db.Text // ✅ Changed to Text for long prompts
  response String? @db.Text // ✅ Changed to Text for long responses
  model    String?

  tokensIn  Int?
  tokensOut Int?

  status String
  error  String? @db.Text

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([siteId])
  @@index([action])
  @@index([createdAt])
}

// =======================================
// RATE LIMIT KV STORE
// =======================================

model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

// =======================================
// WORKSPACES
// =======================================

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String
  createdAt DateTime @default(now())

  members WorkspaceMember[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String @id @default(cuid())
  workspaceId String
  userId      String
  role        String

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

// =======================================
// AI CONVERSATION SYSTEM
// =======================================

model AIMessage {
  id             String @id @default(cuid())
  conversationId String

  role    String // "user" | "assistant" | "system"
  content Json

  createdBy String?
  createdAt DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AIConversation {
  id String @id @default(cuid())

  tenantId String
  siteId   String
  pageId   String

  phase   AIConversationPhase @default(INTERVIEW)
  context Json?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AIMessage[]

  @@unique([tenantId, siteId, pageId])
  @@index([tenantId])
  @@index([siteId])
  @@index([pageId])
}
