# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/apps/web-app/playwright/.auth/
/apps/web-app/playwright-report/
/apps/web-app/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Builder RC local test artifacts
test-results/
playwright-report/
blob-report/
apps/web-app/test-results/
apps/web-app/playwright-report/
apps/web-app/blob-report/
apps/web-app/playwright/.auth/
apps/web-app/.env.e2e.local
# Playwright traces, screenshots and recordings
**/trace.zip
**/test-failed-*.png
**/video.webm
**/error-context.md
# Local RC patch scripts and temporary helpers
scripts/fix_*.py
scripts/add_*_debug.py
scripts/*_debug.py
# Local backup files created during RC patching
*.bak
*.bak2
*.fix2.bak
*.open-order.bak
*.visible-target.bak
*.geometry-debug.bak
*.hit-test.bak
# Generated Next.js output
apps/web-app/.next/
