export function buildV11DesignPrompt(input: V11GenerationInput, creativeBrief?: V11CreativeBrief, research?: V11ResearchPack) {
  const creative = creativeBrief || createV11CreativeBrief(input.context || {}, input.prompt);
  const evidence = research || { status: "unavailable", summary: "Use only supplied facts.", verifiedFacts: [], offerings: [], locations: [], sourceUrls: [], prohibitedClaims: [] };
  const approvedContext = Object.fromEntries(Object.entries(input.context || {}).filter(([key]) => ![
    "referenceAnalysis", "referenceFileUrl", "referenceImageUrl",
  ].includes(key)));
  return `You are BuildEZ AI V11, a world-class web designer and conversion-focused creative director.
Create one complete, premium, production-quality webpage as static TSX. Return TSX only.

USER BRIEF
${input.prompt}

PAGE
${input.pageTitle}

APPROVED CONTEXT
${JSON.stringify(approvedContext, null, 2)}

REFERENCE-TO-BUILDER INSTRUCTION
${typeof input.context?.referenceAnalysis === "string" && input.context.referenceAnalysis.trim()
  ? `A UI image or PDF has been analyzed below. Treat it as the primary visual specification. Reconstruct its complete structure as responsive TSX. Preserve the observed visual system while replacing reference-specific business content with approved website facts.\n\n${input.context.referenceAnalysis}`
  : "No uploaded UI reference was supplied."}

FACT AND CONTENT PACK
${JSON.stringify(evidence, null, 2)}

SHOPEZ COMMERCE CONTRACT
${input.context?.shopezCatalog
  ? `This site has a live Shopez catalog in APPROVED CONTEXT. Product titles, descriptions, prices, compare-at prices, inventory, handles, links, and product image paths MUST come only from shopezCatalog. Never invent, rename, or hardcode substitute products. Use the supplied local product image paths and productUrl values exactly. Product grids are catalog views, not decorative mockups.`
  : `No Shopez catalog was supplied. Do not invent purchasable products, prices, ratings, inventory, discounts, or functional shopping controls. Use clearly non-transactional category or brand storytelling instead.`}

ART DIRECTION — FOLLOW AS A SYSTEM
Name: ${creative.name}
Palette: ${creative.palette.join("; ")}
Typography: ${creative.type}
Composition: ${creative.composition}
Imagery: ${creative.imageDirection}
Conversion: ${creative.conversion}
Quality rules:
${creative.qualityRules.map((rule) => `- ${rule}`).join("\n")}

NON-NEGOTIABLE DESIGN STANDARD
- Make a specific art direction for this use case; never output a generic template.
- Use strong hierarchy, editorial typography, deliberate whitespace, layered media, asymmetric composition, evidence, conversion sections, and a polished footer. Do not turn every section into a grid of rounded cards.
- Write complete, credible, use-case-specific copy. No lorem ipsum, placeholders, vague filler, or invented facts. Claims may come only from the FACT AND CONTENT PACK or APPROVED CONTEXT.
- Include 7-10 substantial sections: navigation, hero, credibility/proof, offering, differentiation/process, showcase, testimonial or evidence, final CTA, footer.
- Every section must feel composed at desktop, tablet, and mobile sizes.
- Write normal, clean, self-contained production React/TSX. You may use local components, helper functions, static data, array maps, conditional rendering, SVG icons, CSS variables, gradients, and responsive Tailwind utilities when they improve the result.
- Do not design around a downstream page-builder compiler. The first artifact is judged as a webpage on its own visual and UX quality.
- Do not import packages or make network requests. The default export must be one component and all required components/data must be in this file.
- Use semantic HTML. Add aria-label="primary-navigation" to the navigation section, aria-label="hero" to the hero section, and aria-label="footer" to the footer section. The generated header/navigation and footer are the authoritative site chrome and must be complete, responsive, and editable.
- Prefer approved uploaded or local assets. When a final asset is unavailable, use a semantically descriptive https image URL; BuildEZ will resolve and persist media after design approval. Never insert unrelated imagery.
- Add meaningful alt text and data-media-role="hero-foreground" or "editorial-image" to important images.
- Use anchors with href="#..." and matching section ids for navigation.
- Keep the component maintainable and avoid needless wrapper elements, but do not sacrifice composition or detail to satisfy a node-count target.`;
}

export function buildV11LoweringPrompt(creativeSource: string, failure?: unknown, allowedAssets: readonly string[] = ASSET_CATALOG) {
  return `You are the BuildEZ compiler adapter. Convert an already-approved React design into semantically equivalent static TSX that the native visual Builder can edit. This is a lowering pass, not a redesign.

APPROVED CREATIVE SOURCE
\`\`\`tsx
${creativeSource}
\`\`\`

${failure ? `THE PRIOR LOWERING FAILED\n${failure instanceof Error ? failure.message : String(failure)}\n` : ""}
PRESERVE EXACTLY
- Section order, content, hierarchy, palette, typography intent, spacing rhythm, image roles, navigation, header, footer, and responsive composition.
- Preserve every substantive section. Do not replace copy with generic agency language.

LOWERING CONTRACT
- Return one complete TSX file only.
- No imports, hooks, event handlers, fetch, style tags, external URLs, optional chaining, Date, Math, template interpolation in visible JSX, or method calls in visible JSX.
- Use static JSX, literal className strings, local literal arrays, and .map() only. Visible expressions may be item.property, index + 1, or a static ternary.
- Add aria-label="primary-navigation", aria-label="hero", and aria-label="footer" to the corresponding elements.
- Preserve image paths already present in the approved source. Allowed local image paths: ${allowedAssets.join(", ")}.
- Use href="#..." anchors with matching ids.
- Do not emit carousel arrows, sliders, pagination dots, accordions, tabs, or other controls unless the native output can provide their behavior. Render repeated content as an honest responsive grid when interaction cannot survive lowering.
- Keep repeated arrays to 6 items or fewer and total expanded intrinsic elements below 300.
- If an effect cannot be represented, approximate that effect while preserving geometry and hierarchy. Never delete a section merely because an implementation detail is unsupported.`;
}

export function resolveV11AttemptProfile(attempt: number, failure?: unknown) {
  const empty = failure instanceof Error && failure.message.includes("V11_EMPTY_MODEL_SOURCE");
  if (attempt === 0) return { reasoningEffort: "low" as const, maxCompletionTokens: 9000, timeoutMs: 75000 };
  if (empty) return { reasoningEffort: "low" as const, maxCompletionTokens: 9000, timeoutMs: 70000 };
  return { reasoningEffort: "low" as const, maxCompletionTokens: 7000, timeoutMs: 60000 };
}

export async function generateV11Website(input: V11GenerationInput): Promise<{
  blueprint: BuilderBlueprint;
  source: string;
  creativeSource: string;
  metadata: Record<string, unknown>;
}> {
  input.onProgress?.("ResearchAgent", "Checking the business, its offer, and the facts the page can safely use.");
  const creativeBrief = createV11CreativeBrief(input.context || {}, input.prompt);
  const research = await researchV11Business(input.context || {}, input.prompt);
  input.onProgress?.("DesignAgent", "Creating the production React design without Builder compiler restrictions.");
  const designPrompt = buildV11DesignPrompt(input, creativeBrief, research);
  const model = process.env.OPENAI_V11_MODEL || "gpt-5.6-sol";
  const referenceCodeModel = process.env.OPENAI_V11_REFERENCE_CODE_MODEL || model;
  const hasVisualReference = typeof input.context?.referenceAnalysis === "string" && Boolean(input.context.referenceAnalysis.trim());
  let creativeSource = "";
  try {
    const generatedCreative = await generateCodeFirstInBackground(
      hasVisualReference ? referenceCodeModel : model,
      designPrompt,
      input.onProgress
    );
    creativeSource = extractTsx(generatedCreative);
    parseTsx(creativeSource, "ai-v11-creative-source.tsx");
    assertReferenceFidelity(creativeSource, input.context || {});
  } catch (error) {
    const message = error instanceof Error ? error.message : String(error);
    if (message.includes("V11_CREATIVE_OUTPUT_TRUNCATED")) {
      input.onProgress?.("RepairAgent", "The first design exceeded the response limit. Rebuilding the same direction as a complete compact page.");
      const compactResponse = await callOpenAIChatCompletion({
        model: process.env.OPENAI_V11_RECOVERY_MODEL || "gpt-5.6-sol",
        debugLabel: "builder-ai-v11-truncation-recovery",
        messages: [{ role: "user", content: `${designPrompt}\n\nCOMPACT COMPLETION REQUIREMENT\nReturn a complete TSX file within 7,000 output tokens. Preserve all substantive sections and the reference structure, but reduce decorative wrappers and repeated items. Do not explain.` }],
        reasoningEffort: "none",
        maxCompletionTokens: 9000,
        timeoutMs: 75000,
      });
      creativeSource = extractTsx(extractAssistantText(compactResponse));
      parseTsx(creativeSource, "ai-v11-creative-recovery.tsx");
      assertReferenceFidelity(creativeSource, input.context || {});
    } else if (/timeout|timed out|aborted/i.test(message)) {
      throw new Error("V11_CREATIVE_GENERATION_TIMEOUT: The code-first design did not finish in time. No page was changed.");
    } else {
      throw error;
    }
  }
  await input.onCreativeSource?.(creativeSource);

  // Most code-first pages are already static enough for the native compiler.
  // Always attempt deterministic local compilation before paying for a second
  // model call; the adapter is only a compatibility repair path.
  try {
    input.onProgress?.("BlueprintCompilerAgent", "Trying direct local conversion of the completed React design.");
    const directSource = sanitizeGeneratedTsx(creativeSource, preferredAssetsForContext(input.context || {}));
    const directResult = compileGeneratedSource(directSource);
    return {
      ...directResult,
      creativeSource,
      metadata: {
        ...directResult.metadata,
        creativeBrief,
        research: { status: research.status, sources: research.sourceUrls, verifiedFactCount: research.verifiedFacts.length },
        codeFirst: { preserved: true, syntaxValidated: true, loweringMode: "deterministic-local", loweringAttempts: 0 },
        referenceFidelityWarnings: referenceFidelityWarnings(directSource, input.context || {}),
      },
    };
  } catch (directCompilationError) {
    input.onProgress?.("BlueprintCompilerAgent", `The design uses features outside native nodes; running one compatibility conversion (${directCompilationError instanceof Error ? directCompilationError.message.split(":")[0] : "unsupported source"}).`);
  }

  input.onProgress?.("BlueprintCompilerAgent", "Lowering the approved React design into editable native Builder nodes.");
  let source = "";
  let failure: unknown;
  for (let attempt = 0; attempt < 2; attempt += 1) {
    const loweringPrompt = buildV11LoweringPrompt(creativeSource, attempt === 0 ? undefined : failure, preferredAssetsForContext(input.context || {}));
    try {
      const generatedText = extractAssistantText(await callOpenAIChatCompletion({
        model: process.env.OPENAI_V11_LOWERING_MODEL || "gpt-5.6-sol",
        debugLabel: attempt === 0 ? "builder-ai-v11-lower-to-native" : "builder-ai-v11-repair-native-lowering",
        messages: [{ role: "user", content: loweringPrompt }],
        reasoningEffort: "none",
        maxCompletionTokens: attempt === 0 ? 8000 : 6500,
        timeoutMs: attempt === 0 ? 150000 : 90000,
      }));
      source = sanitizeGeneratedTsx(extractTsx(generatedText), preferredAssetsForContext(input.context || {}));
      assertReferenceFidelity(source, input.context || {});
    } catch (error) {
      failure = error;
      const message = error instanceof Error ? error.message : String(error);
      if (/timeout|timed out|aborted/i.test(message)) {
        throw new Error("V11_NATIVE_LOWERING_TIMEOUT: The completed React design could not be converted to native nodes within the adapter window. The code artifact has been retained for recovery.");
      }
      continue;
    }
    try {
      input.onProgress?.("BlueprintCompilerAgent", "Converting the generated TSX into editable Builder nodes.");
      const result = compileGeneratedSource(source);
      input.onProgress?.("QAAgent", "Validating responsive structure, content, header, footer, and editability.");
      return {
        ...result,
        creativeSource,
        metadata: {
          ...result.metadata,
          creativeBrief,
          research: { status: research.status, sources: research.sourceUrls, verifiedFactCount: research.verifiedFacts.length },
          codeFirst: { preserved: true, syntaxValidated: true, loweringAttempts: attempt + 1 },
          referenceFidelityWarnings: referenceFidelityWarnings(source, input.context || {}),
        },
      };
    } catch (error) {
      failure = error;
    }
  }
  throw failure instanceof Error ? failure : new Error("V11_NATIVE_LOWERING_FAILED: The approved design could not be converted to Builder nodes. No page was changed.");
}

function compileGeneratedSource(source: string): {
  blueprint: BuilderBlueprint;
  source: string;
  metadata: Record<string, unknown>;
} {
  if (!source) throw new Error("V11_EMPTY_MODEL_SOURCE");
  const file = "ai-v11-generated.tsx";
  const gate = assessUntrustedSource(source, file, PRODUCTION_EVALUATION_BUDGETS);
  if (!gate.safe) {
    const details = gate.findings
      .map((item) => {
        const location = `${file}:${item.line}:${item.column}`;
        const message =
          "message" in item && typeof item.message === "string"
            ? `: ${item.message}`
            : "";
        return `${item.code} at ${location}${message}`;
      })
      .join("\n");

    throw new Error(`V11_SOURCE_REJECTED:\n${details}`);
  }
  const parsed = parseTsx(source, file);
  const graph = buildDesignGraph(normalizeTsx(parsed), PRODUCTION_EVALUATION_BUDGETS);
  const graphValidation = validateDesignGraph(graph);
  if (!graphValidation.valid) throw new Error(`V11_GRAPH_INVALID: ${graphValidation.issues.join(", ")}`);
  const compilation = compileDesignGraphToBlueprint(graph);
  const validation = validateBlueprint(compilation.blueprint);
  if (!validation.valid) throw new Error(`V11_BLUEPRINT_INVALID: ${validation.issues.map(formatValidationIssue).join("\n\n")}`);
  const serialized = serializeBlueprint(compilation.blueprint);
  if (!serialized.ok) throw new Error("V11_SERIALIZATION_FAILED");
  const roundTrip = deserializeBlueprint(serialized.value);
  if (!roundTrip.ok) throw new Error("V11_ROUND_TRIP_FAILED");
  for (const id of roundTrip.value.nodes[roundTrip.value.root]?.children || []) {
    const node = roundTrip.value.nodes[id];
    if (node?.type === "section") node.style = { ...node.style, width: "100%" };
  }
  const completeness = validateFullPageCompleteness({ source, ast: parsed.ast, graph, blueprint: roundTrip.value, diagnostics: compilation.diagnostics });
  if (!completeness.valid) throw new Error(`V11_PAGE_INCOMPLETE: ${completeness.issues.join(" ")}`);
  const warnings = compilation.diagnostics.filter((item) => item.severity === "warning");
  const qualityWarnings = [
    ...completeness.warnings,
    ...warnings.map((item) => item.message),
  ];

  return {
    blueprint: roundTrip.value,
    source,
    metadata: {
      aiGenerationVersion: "v11",
      aiDesignStatus: "pending_review",
      aiDesignScope: "current_page_only",
      qualityStatus: qualityWarnings.length > 12 ? "needs_improvement" : "passed",
      qualityScore: Math.max(70, 100 - qualityWarnings.length * 2),
      qualityWarnings: qualityWarnings.slice(0, 8),
      v11: { nodeCount: Object.keys(roundTrip.value.nodes).length, sectionCount: completeness.compiled.sections, diagnostics: compilation.diagnostics.length },
    },
  };
}
