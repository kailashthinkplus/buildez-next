export type V11GenerationInput = Readonly<{
  prompt: string;
  pageTitle: string;
  context?: Record<string, unknown>;
  onProgress?: (agent: string, summary: string) => void;
  onCreativeSource?: (source: string) => Promise<void> | void;
}>;

const ASSET_CATALOG = [
  "/v11-premium/agency.png", "/v11-premium/ai-saas.png", "/v11-premium/architecture.png",
  "/v11-premium/automotive.png", "/v11-premium/clinic.png", "/v11-premium/fashion.png",
  "/v11-premium/fintech.png", "/v11-premium/product.png", "/v11-premium/real-estate.png",
  "/v11-premium/resort.png",
] as const;
const PRODUCTION_EVALUATION_BUDGETS = Object.freeze({
  maxNodeCount: 650,
  maxExpansionCount: 300,
  maxOperations: 30000,
});

function extractTsx(value: string) {
  const fenced = value.match(/```(?:tsx|jsx|typescript)?\s*([\s\S]*?)```/i)?.[1];
  return (fenced || value).trim();
}

function responseOutputText(payload: unknown) {
  const root = payload && typeof payload === "object" ? payload as Record<string, unknown> : {};
  if (typeof root.output_text === "string") return root.output_text.trim();
  return (Array.isArray(root.output) ? root.output : []).flatMap((item) => {
    const content = item && typeof item === "object" ? (item as Record<string, unknown>).content : [];
    return Array.isArray(content) ? content : [];
  }).map((item) => item && typeof item === "object" && typeof (item as Record<string, unknown>).text === "string"
    ? String((item as Record<string, unknown>).text) : "").filter(Boolean).join("\n").trim();
}

async function generateCodeFirstInBackground(model: string, prompt: string, onProgress?: V11GenerationInput["onProgress"]) {
  const apiKey = process.env.OPENAI_API_KEY;
  if (!apiKey) throw new Error("Missing OPENAI_API_KEY");
  const headers = { "Content-Type": "application/json", Authorization: `Bearer ${apiKey}` };
  const started = await fetch("https://api.openai.com/v1/responses", {
    method: "POST",
    headers,
    body: JSON.stringify({ model, input: prompt, background: true, reasoning: { effort: "none" }, max_output_tokens: 14000 }),
    cache: "no-store",
    signal: AbortSignal.timeout(20000),
  });
  const raw = await started.text();
  let response: Record<string, unknown>;
  try { response = JSON.parse(raw) as Record<string, unknown>; } catch { throw new Error(`V11_BACKGROUND_START_INVALID (${started.status})`); }
  if (!started.ok || typeof response.id !== "string") throw new Error(`V11_BACKGROUND_START_FAILED (${started.status}): ${responseOutputText(response) || raw.slice(0, 500)}`);
  const deadline = Date.now() + 180000;
  let lastNotice = 0;
  while (response.status === "queued" || response.status === "in_progress") {
    if (Date.now() >= deadline) throw new Error(`V11_CREATIVE_BACKGROUND_PENDING: Response ${String(response.id)} is still processing; no page was changed.`);
    await new Promise((resolve) => setTimeout(resolve, 2000));
    const elapsedSeconds = Math.round((180000 - (deadline - Date.now())) / 1000);
    if (elapsedSeconds - lastNotice >= 12) {
      lastNotice = elapsedSeconds;
      onProgress?.("DesignAgent", `The code-first design is still rendering (${elapsedSeconds}s); the request remains recoverable.`);
    }
    const polled = await fetch(`https://api.openai.com/v1/responses/${response.id}`, { headers, cache: "no-store", signal: AbortSignal.timeout(15000) });
    const pollRaw = await polled.text();
    try { response = JSON.parse(pollRaw) as Record<string, unknown>; } catch { throw new Error(`V11_BACKGROUND_POLL_INVALID (${polled.status})`); }
    if (!polled.ok) throw new Error(`V11_BACKGROUND_POLL_FAILED (${polled.status})`);
  }
  const text = responseOutputText(response);
  if (response.status === "incomplete" && text) {
    try {
      parseTsx(extractTsx(text), "ai-v11-incomplete-but-usable.tsx");
      onProgress?.("DesignAgent", "The model reached its response limit, but returned a complete valid design; continuing safely.");
      return text;
    } catch {
      const details = response.incomplete_details && typeof response.incomplete_details === "object"
        ? JSON.stringify(response.incomplete_details) : "unknown reason";
      throw new Error(`V11_CREATIVE_OUTPUT_TRUNCATED: ${details}`);
    }
  }
  if (response.status !== "completed") {
    const details = response.incomplete_details && typeof response.incomplete_details === "object"
      ? JSON.stringify(response.incomplete_details) : "no details returned";
    throw new Error(`V11_CREATIVE_BACKGROUND_${String(response.status || "FAILED").toUpperCase()}: ${details}`);
  }
  if (!text) throw new Error("V11_EMPTY_MODEL_SOURCE");
  return text;
}

export function sanitizeGeneratedTsx(value: string, preferredAssets: readonly string[] = ASSET_CATALOG) {
  let assetIndex = 0;
  const nextAsset = () => {
    const asset = preferredAssets[assetIndex % preferredAssets.length] || ASSET_CATALOG[7];
    assetIndex += 1;
    return asset;
  };
  return value
    .replace(/\bsrc\s*=\s*(["'])https?:\/\/[^"']+\1/gi, () => {
      return `src="${nextAsset()}"`;
    })
    .replace(/\bsrc\s*=\s*(["'])\/v11-premium\/[^"']+\1/gi, () => `src="${nextAsset()}"`)
    .replace(/\bhref\s*=\s*(["'])https?:\/\/[^"']+\1/gi, 'href="#contact"')
    .replace(/https?:\/\/[^\s"'`}<]+/gi, "");
}

function preferredAssetsForContext(context: Record<string, unknown>) {
  const catalog = context.shopezCatalog && typeof context.shopezCatalog === "object" ? context.shopezCatalog as Record<string, unknown> : {};
  const products = Array.isArray(catalog.products) ? catalog.products : [];
  const catalogImages = products.flatMap((product) => {
    const images = product && typeof product === "object" ? (product as Record<string, unknown>).images : [];
    return Array.isArray(images) ? images.map((image) => image && typeof image === "object" ? String((image as Record<string, unknown>).src || "") : "").filter(Boolean) : [];
  });
  if (catalogImages.length) return catalogImages;
  const description = `${context.industry || ""} ${context.useCase || ""} ${context.referenceAnalysis || ""}`.toLowerCase();
  if (/shop|store|e-?commerce|product|skincare|beauty|cosmetic/.test(description)) {
    return ["/v11-premium/product.png", "/v11-premium/fashion.png"] as const;
  }
  return ASSET_CATALOG;
}

export function assertReferenceFidelity(source: string, context: Record<string, unknown>) {
  const analysis = String(context.referenceAnalysis || "").toLowerCase();
  if (!analysis) return;
  const normalized = source.toLowerCase();
  const genericMarkers = ["a better way to move forward", "understand", "create", "deliver", "start a conversation"];
  if (genericMarkers.filter((term) => normalized.includes(term)).length >= 3) {
    throw new Error("V11_REFERENCE_FIDELITY_FAILED: Generic template content replaced the uploaded design.");
  }
}

export function referenceFidelityWarnings(source: string, context: Record<string, unknown>) {
  const analysis = String(context.referenceAnalysis || "").toLowerCase();
  if (!analysis || !/e-?commerce|storefront|product grid|product card|shopping|catalog|skincare|beauty/.test(analysis)) return [];
  const normalized = source.toLowerCase();
  const commerceSignals = ["product", "collection", "categor", "shop", "cart", "sale", "bestseller", "best seller", "newsletter", "new arrival", "price", "blog", "serum", "cream", "₹", "$", "£", "€"];
  const matched = commerceSignals.filter((term) => normalized.includes(term));
  return matched.length >= 2 ? [] : ["The commerce vocabulary score was low; review storefront sections visually before accepting the design."];
}

