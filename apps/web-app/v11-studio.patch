+export default function Page(){ if(!isV11VisualPreviewAvailable()) notFound(); return <main style={{minHeight:"100vh",background:"#070a10",color:"#f8fafc",padding:"56px 24px",fontFamily:"Inter,system-ui,sans-serif"}}><div style={{width:"min(1180px,100%)",margin:"0 auto"}}><p style={{color:"#60a5fa",fontSize:12,fontWeight:700,letterSpacing:".16em",textTransform:"uppercase"}}>BuildEZ AI V11 · Internal</p><h1 style={{margin:"12px 0",fontSize:52,letterSpacing:"-.04em"}}>Visual Compiler Studio</h1><p style={{maxWidth:760,color:"#94a3b8",lineHeight:1.7,marginBottom:40}}>Compare the trusted TSX reference with the native Blueprint rendered by PublishedPageRenderer.</p><div style={{display:"grid",gridTemplateColumns:"repeat(auto-fit,minmax(300px,1fr))",gap:16}}>{IDS.map(id=>{const f=buildV11VisualFixture(id);return <Link key={id} href={`/internal/v11-studio/${id}`} style={{padding:20,border:"1px solid #263247",borderRadius:16,background:"#0f172a",color:"inherit",textDecoration:"none"}}><div style={{color:"#60a5fa",fontSize:11,fontWeight:700,textTransform:"uppercase"}}>{f.classification}</div><strong style={{display:"block",marginTop:8,fontSize:19}}>{id}</strong><div style={{marginTop:10,color:"#94a3b8",fontSize:13}}>{Object.keys(f.graph.nodes).length} graph · {Object.keys(f.blueprint.nodes).length} Blueprint · {f.diagnostics.length} diagnostics</div></Link>})}</div></div></main>}

