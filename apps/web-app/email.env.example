# Transactional email — Google Workspace SMTP (works the same for a plain
# Gmail account). Used for OTPs, plan-activation confirmations, plan
# expiry/renewal alerts, and any other automated user email (lib/email/).
#
# Setup (Google Workspace admin, once):
#   1. Sign in to support@getbuildezy.com.
#   2. Enable 2-Step Verification on the account (required for app passwords):
#      https://myaccount.google.com/security
#   3. Create an App Password: https://myaccount.google.com/apppasswords
#      (choose "Mail" as the app). Copy the 16-character password below —
#      it is NOT the account's login password.
#   4. If your Workspace admin has "Less secure apps"/third-party app access
#      restricted org-wide, allow app passwords for this account (or ask
#      your admin to allow it) — otherwise Google will reject the login.
#
# Without SMTP_USER/SMTP_APP_PASSWORD set, email is logged to the server
# console instead of sent (see lib/email/sendMail.ts) — safe for local dev.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=support@getbuildezy.com
SMTP_APP_PASSWORD= ghlvqvsiqjhxvccr
SMTP_FROM="BuildEZ <support@getbuildezy.com>"

# Shared secret required by the external-cron-triggered alert routes
# (app/api/cron/publish-scheduled, app/api/cron/check-subscription-expiry).
# Point an external scheduler (Vercel Cron, cron-job.org, GitHub Actions) at
# these routes with this value as the `x-cron-secret` header or `?secret=`
# query param. check-subscription-expiry only needs to run once a day.
CRON_SECRET=
