# Dodo Payments subscription billing
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# DODO_PAYMENTS_WEBHOOK_SECRET is also accepted for compatibility with Dodo examples.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/app/workspace/billing

# Map each public BuildEZ plan and billing cycle to its Dodo subscription product.
# Add only the plans that exist in your database/Dodo dashboard.
DODO_PAYMENTS_PRODUCT_IDS={"STARTER:MONTHLY":"pdt_replace_me","STARTER:YEARLY":"pdt_replace_me","PRO:MONTHLY":"pdt_replace_me","PRO:YEARLY":"pdt_replace_me","BUSINESS:MONTHLY":"pdt_replace_me","BUSINESS:YEARLY":"pdt_replace_me"}

# One-time products used for AI-credit top-ups. Prices are major currency units
# and are display-only; fulfillment trusts the signed webhook and product id.
DODO_PAYMENTS_CREDIT_PRODUCTS={"CREDITS_500":{"name":"500 AI credits","credits":500,"price":499,"currency":"INR","productId":"pdt_replace_me"},"CREDITS_2000":{"name":"2,000 AI credits","credits":2000,"price":1499,"currency":"INR","productId":"pdt_replace_me"},"CREDITS_5000":{"name":"5,000 AI credits","credits":5000,"price":2999,"currency":"INR","productId":"pdt_replace_me"}}
