{
  "name": "web-app",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --dir ../../packages/db prisma:generate && next build",
    "start": "next start",
    "replay:v11": "node --import tsx scripts/replay-v11-source.ts",
    "typecheck:builder": "tsc -p tsconfig.builder.json --noEmit",
    "test:v12:rc1": "node --import tsx --test modules/v12-boundaries.test.ts modules/builder-v3/visual-editor/visualEditor.test.ts modules/builder-v3/visual-editor/selectionDescription.test.ts modules/ai-v12/commerce.test.ts modules/ai-v12/creativeDirection.test.ts modules/ai-v12/importedProject.test.ts",
    "test:builder": "node --import tsx --test --test-concurrency=1 $(find modules/builder-v2/__tests__ -name '*.test.ts' -print)",
    "test:builder:rc-t1": "node --import tsx --test --test-concurrency=1 $(find modules/builder-v2/__tests__/commands modules/builder-v2/__tests__/serialization modules/builder-v2/__tests__/rc-t1 -name '*.test.ts' -print)",
    "test:builder:rc-t2": "node --import tsx --test --test-concurrency=1 $(find modules/builder-v2/__tests__/canvas modules/builder-v2/__tests__/layout modules/builder-v2/__tests__/responsive modules/builder-v2/__tests__/parity modules/builder-v2/__tests__/workspace modules/builder-v2/__tests__/rc-t2 -name '*.test.ts' -print)",
    "test:builder:rc-t3": "node --import tsx --test --test-concurrency=1 $(find modules/builder-v2/__tests__/commands modules/builder-v2/__tests__/rc-t1/commands modules/builder-v2/__tests__/rc-t3 -name '*.test.ts' -print)",
    "test:builder:operations": "node --import tsx --test --test-concurrency=1 $(find modules/builder-v2/__tests__/rc-t3 -name '*.test.ts' -print)",
    "test:builder:layout": "node --import tsx --test --test-concurrency=1 $(find modules/builder-v2/__tests__/layout modules/builder-v2/__tests__/responsive modules/builder-v2/__tests__/rc-t2/layout -name '*.test.ts' -print)",
    "test:builder:canvas": "node --import tsx --test --test-concurrency=1 $(find modules/builder-v2/__tests__/canvas modules/builder-v2/__tests__/workspace modules/builder-v2/__tests__/rc-t2/canvas -name '*.test.ts' -print 2>/dev/null)",
    "test:builder:blueprint": "node --import tsx --test --test-concurrency=1 $(find modules/builder-v2/__tests__/serialization modules/builder-v2/__tests__/rc-t1/blueprint -name '*.test.ts' -print)",
    "test:builder:commands": "node --import tsx --test --test-concurrency=1 $(find modules/builder-v2/__tests__/commands modules/builder-v2/__tests__/rc-t1/commands -name '*.test.ts' -print)",
    "test:builder:watch": "node --import tsx --test --test-concurrency=1 --watch $(find modules/builder-v2/__tests__ -name '*.test.ts' -print)",
    "playwright:install": "playwright install chromium",
    "test:builder:browser:auth": "playwright test --project=setup",
    "test:builder:browser": "playwright test --project=builder-chromium",
    "test:builder:browser:operations": "playwright test --project=builder-chromium --grep @operations",
    "test:builder:browser:operations:headed": "playwright test --project=builder-chromium --grep @operations --headed",
    "test:builder:browser:operations:fixture": "playwright test --project=builder-chromium --grep @fixture",
    "test:builder:browser:operations:dnd": "playwright test --project=builder-chromium --grep @dnd",
    "test:builder:browser:operations:palette": "playwright test --project=builder-chromium --grep @palette",
    "test:builder:browser:operations:reorder": "playwright test --project=builder-chromium --grep @reorder",
    "test:builder:browser:operations:keyboard": "playwright test --project=builder-chromium --grep @keyboard",
    "test:builder:browser:operations:invalid": "playwright test --project=builder-chromium --grep @invalid-dnd",
    "test:builder:browser:operations:cleanup": "tsx playwright/scripts/cleanupDisposablePages.ts",
    "test:builder:visual": "playwright test --project=setup && playwright test --project=builder-chromium --no-deps --grep @visual",
    "test:builder:visual:update": "playwright test --project=setup && playwright test --project=builder-chromium --no-deps --grep @visual --update-snapshots",
    "test:builder:browser:operations:scroll": "playwright test --project=builder-chromium --grep @scroll",
    "test:builder:browser:operations:zoom": "playwright test --project=builder-chromium --grep @zoom",
    "test:builder:browser:operations:responsive": "playwright test --project=builder-chromium --grep @responsive",
    "test:builder:browser:operations:persistence": "playwright test --project=builder-chromium --grep @persistence",
    "test:builder:browser:operations:copy-paste": "playwright test --project=builder-chromium --grep @copy-paste",
    "test:builder:browser:operations:journeys": "playwright test --project=builder-chromium --grep @journeys"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/s3-request-presigner": "^3.1073.0",
    "@babel/standalone": "^7.29.1",
    "@buildez/db": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dodopayments/core": "^0.3.15",
    "@dodopayments/nextjs": "^0.3.9",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@radix-ui/react-switch": "^1.3.4",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@tiptap/extension-horizontal-rule": "^3.15.3",
    "@tiptap/extension-link": "^3.15.3",
    "@tiptap/extension-text-align": "^3.15.3",
    "@tiptap/extension-underline": "^3.15.3",
    "@tiptap/react": "^3.15.3",
    "@tiptap/starter-kit": "^3.15.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "7.9.0",
    "d3-geo": "^3.1.1",
    "dodopayments": "^2.48.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "framer-motion": "12.24.7",
    "geoip-lite": "^2.0.3",
    "gsap": "3.15.0",
    "isomorphic-dompurify": "^4.1.0",
    "lottie-react": "2.4.1",
    "lucide-react": "0.562.0",
    "motion": "13.1.1",
    "nanoid": "^3.3.11",
    "next": "15.2.8",
    "next-themes": "0.4.6",
    "node-vibrant": "4.0.4",
    "nodemailer": "^9.0.6",
    "openai": "^6.44.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-quill": "^2.0.0",
    "react-router-dom": "^7.18.2",
    "sharp": "^0.35.2",
    "slugify": "1.6.6",
    "stripe": "^17.5.0",
    "swr": "^2.3.8",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "0.185.1",
    "topojson-client": "^3.1.0",
    "unzipper": "^0.12.5",
    "uuid": "^13.0.0",
    "world-atlas": "^2.0.2",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/d3-geo": "^3.1.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/nodemailer": "^8.0.1",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@types/unzipper": "^0.10.11",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.17",
    "tsx": "^4.21.0",
    "vite": "^8.1.5"
  }
}
