# Optional: enables Higgsfield as a remote MCP tool during Builder V12 generation.
# The installed Codex plugin connection is separate and cannot be reused by the web app.
HIGGSFIELD_MCP_URL=
HIGGSFIELD_MCP_TOKEN=

# Optional immersive-only creative production MCPs. These are exposed to the
# generation agent only when the experience pill or explicit prompt requests
# 3D, WebGL, shaders, cinematic scrolling, or immersive parallax.
RUNWAY_MCP_URL=
RUNWAY_MCP_TOKEN=
MESHY_MCP_URL=
MESHY_MCP_TOKEN=
SPLINE_MCP_URL=
SPLINE_MCP_TOKEN=
FIGMA_MCP_URL=
FIGMA_MCP_TOKEN=

# Optional JSON array for additional providers:
# [{"label":"provider","url":"https://...","token":"...","capabilities":["images","video","threeD","design"]}]
BUILDEZ_CREATIVE_MCP_SERVERS=
