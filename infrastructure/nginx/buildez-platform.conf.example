upstream buildez_app {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name getbuildezy.com *.getbuildezy.com;
    location ^~ /.well-known/acme-challenge/ { root /var/lib/buildez/acme; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name getbuildezy.com *.getbuildezy.com;
    ssl_certificate /etc/letsencrypt/live/getbuildezy.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/getbuildezy.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 32m;
    location / {
        proxy_pass http://buildez_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
